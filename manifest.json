{
	"name": "CustomYT Extension",
	"version": "1.0.0",
	"description": "This extension was created to address various flaws in YouTube and provide necessary fixes.",
	"manifest_version": 3,
	"author": "SamGun-Official",
	"action": {
		"default_icon": {
			"16": "src/images/logo.png",
			"24": "src/images/logo.png",
			"32": "src/images/logo.png"
		},
		"default_popup": "popup.html",
		"default_title": "CustomYT Extension"
	},
	"background": {
		"service_worker": "src/js/background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"*://youtube.com/*",
				"*://www.youtube.com/*",
				"*://m.youtube.com/*"
			],
			"exclude_matches": [
				"*://*.music.youtube.com/*"
			],
			"js": [
				"src/js/content.js"
			]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"scripts/yt-no-ads.js",
				"scripts/yt-no-chat.js",
				"scripts/yt-no-shorts.js"
			],
			"matches": [
				"*://*.youtube.com/*"
			]
		}
	],
	"externally_connectable": {
		"matches": [
			"*://*.youtube.com/*"
		]
	},
	"host_permissions": [
		"*://*.youtube.com/*"
	],
	"icons": {
		"16": "src/images/logo.png",
		"32": "src/images/logo.png",
		"48": "src/images/logo.png",
		"128": "src/images/logo.png"
	},
	"permissions": [
		"storage",
		"tabs"
	]
}